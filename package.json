{
  "name": "vscode-react-memoize",
  "displayName": "vscode-react-memoize",
  "version": "0.0.14",
  "description": "Instantly transform variables and function in useMemo and useCallback with tracked dependencies array",
  "categories": [
    "Other"
  ],
  "homepage": "https://apperside.github.io/vscode-react-memoize/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apperside/vscode-react-memoize.git"
  },
  "sponsor": {
    "url": "https://ko-fi.com/apperside"
  },
  "publisher": "apperside",
  "type": "module",
  "main": "./out/extension.js",
  "scripts": {
    "test": "node --import tsx --test src/test/*.test.ts",
    "compile": "tsc -p .",
    "package": "npm run compile && npx @vscode/vsce package",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.85.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsx": "^4.19.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "reactMemoize.showLog",
        "title": "vscode-react-memoize: Show Debug Log"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.86.0"
  }
}
